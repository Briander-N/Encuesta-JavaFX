<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="541.0" prefWidth="409.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.encuestajavafx.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Label fx:id="lblT1" text="Encuesta" />
      <Label fx:id="lblT2" text="NINTENDEROS">
         <VBox.margin>
            <Insets top="-21.0" />
         </VBox.margin>
      </Label>
      <AnchorPane prefHeight="315.0" prefWidth="369.0">
         <children>
            <Label fx:id="lblQ1" layoutX="16.0" layoutY="14.0" text="¿Cuál era el nombre original de Mario en 'Donkey Kong' (1981)?" textAlignment="CENTER" textOverrun="CLIP" />
            <TextField fx:id="txtQ1" layoutX="46.0" layoutY="37.0" prefHeight="25.0" prefWidth="280.0" />
            <Label fx:id="lblQ2" layoutX="25.0" layoutY="75.0" text="¿Cuál es la consola peor vendida en la historia de Nintendo?" />
            <ComboBox fx:id="cmbQ2" layoutX="43.0" layoutY="100.0" prefHeight="25.0" prefWidth="280.0" />
            <Label fx:id="lblQ3" layoutX="47.0" layoutY="141.0" text="¿Cuál fue el penúltimo personaje en entrar a SSBU?" />
            <TextField fx:id="txtQ3" layoutX="44.0" layoutY="162.0" prefHeight="25.0" prefWidth="280.0" />
            <Label fx:id="lblQ4" layoutX="47.0" layoutY="199.0" text="¿Cuál fue la primera consola de Nintendo en incluir" />
            <ComboBox fx:id="cmbQ4" layoutX="44.0" layoutY="233.0" prefHeight="25.0" prefWidth="280.0" />
            <Button fx:id="btnEnviar" layoutX="122.0" layoutY="271.0" mnemonicParsing="false" onAction="#calcularPuntaje" prefHeight="28.0" prefWidth="126.0" text="Enviar Respuestas" />
            <Label layoutX="58.0" layoutY="216.0" text="conectividad inalámbrica nativa sin accesorios?" />
         </children>
      </AnchorPane>
      <AnchorPane prefHeight="138.0" prefWidth="299.0">
         <children>
            <Label fx:id="lblPuntaje" layoutX="160.0" layoutY="8.0" text="PUNTAJE">
               <padding>
                  <Insets bottom="20.0" top="20.0" />
               </padding>
            </Label>
            <Label fx:id="lblResultados" layoutX="127.0" layoutY="57.0">
               <font>
                  <Font size="49.0" />
               </font>
               <padding>
                  <Insets bottom="30.0" />
               </padding>
            </Label>
         </children>
      </AnchorPane>
   </children>
</VBox>
